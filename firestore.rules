/**
 * firestore.rules
 * 
 * Defines access control for the HearMeOut Firestore database.
 * 
 * Architecture:
 * - Public: Posts (read-only)
 * - Users: Must be authenticated, can only write to their own profile/likes/requests.
 * - Social: Likes and comments use atomic counters on the parent post.
 * - Validation: Ensures users don't modify critical system fields or metadata.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /** Check if the user is authenticated with Firebase Auth. */
    function isAuth() {
      return request.auth != null;
    }

    /** Check if the authenticated user's UID matches the provided UID. */
    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    /** Check if the authenticated user is an administrator. */
    function isAdmin() {
      return isAuth() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // -------------------------------------------------------------------------
    // POSTS COLLECTION
    // -------------------------------------------------------------------------
    match /posts/{postId} {
      // Allow any visitor to browse the feed.
      allow read: if true;
      
      // Creating a post requires authentication.
      allow create: if isAuth();

      // Update post permission:
      // 1. Owners can update their own post content, but cannot cheat the like count.
      // 2. Any logged-in user can update ONLY the 'likes' or 'commentCount' field (via transactions).
      // 3. Admins can update anything.
      allow update: if isAuth() && (
        isAdmin() ||
        (isOwner(resource.data.authorId) && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes', 'commentCount'])
        )
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentCount']))
      );

      // Only the author or an admin can delete their post.
      allow delete: if isAuth() && (isOwner(resource.data.authorId) || isAdmin());

      // --- Likes Subcollection ---
      match /likes/{likeId} {
        allow read: if isAuth();
        allow create, delete: if isAuth() && isOwner(likeId);
      }

      // --- Comments Subcollection ---
      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update, delete: if isAuth() && (isOwner(resource.data.authorId) || isAdmin());
      }
    }

    // -------------------------------------------------------------------------
    // USERS COLLECTION
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // Users can see other users.
      allow read: if isAuth();
      
      /**
       * User Update Rules:
       * 1. Admins: Full access.
       * 2. Owners: Can edit their profile but cannot change system fields (role, premium, uid, createdAt).
       * 3. Social Actions: Users can modify the 'friends' array 
       *    on OTHER users' documents, but ONLY to add/remove their OWN UID.
       */
      allow update: if isAuth() && (
        isAdmin() ||
        (isOwner(userId) && 
          request.resource.data.role == resource.data.role &&
          request.resource.data.isPremium == resource.data.isPremium &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.uid == resource.data.uid &&
          (
            (resource.data.listenerStatus == 'none' && request.resource.data.listenerStatus == 'pending') ||
            (request.resource.data.listenerStatus == resource.data.listenerStatus)
          ) &&
          (
            (resource.data.role == 'listener' && request.resource.data.diff(resource.data).affectedKeys().hasAny(['listenerActive'])) ||
            (request.resource.data.listenerActive == resource.data.listenerActive)
          )
        ) ||
        (
          !isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']) &&
          (
            (request.resource.data.friends.hasAll(resource.data.friends) && 
             request.resource.data.friends.removeAll(resource.data.friends).hasOnly([request.auth.uid])) ||
            (resource.data.friends.hasAll(request.resource.data.friends) && 
             resource.data.friends.removeAll(request.resource.data.friends).hasOnly([request.auth.uid]))
          )
        )
      );

      // --- Bookmarks Subcollection ---
      match /bookmarks/{postId} {
        allow read, write: if isAuth() && isOwner(userId);
      }
    }

    // -------------------------------------------------------------------------
    // ROOMS COLLECTION (Premium Feature Scaffolding)
    // -------------------------------------------------------------------------
    match /rooms/{roomId} {
      allow read: if isAuth();
      allow create: if isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPremium == true;
      allow update, delete: if isAuth() && (isOwner(resource.data.ownerId) || isAdmin());
    }

    // -------------------------------------------------------------------------
    // USERNAMES COLLECTION (Uniqueness reservation)
    // -------------------------------------------------------------------------
    match /usernames/{lowercaseUsername} {
      allow read: if true;
      allow create: if isAuth() && isOwner(request.resource.data.uid);
      allow delete: if isAuth() && isOwner(resource.data.uid);
    }

    // -------------------------------------------------------------------------
    // CHATS COLLECTION
    // -------------------------------------------------------------------------
    match /chats/{chatId} {
      allow read: if isAuth() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isAuth();
      allow update: if isAuth() && (request.auth.uid in resource.data.participants || isAdmin());

      // --- Messages Subcollection ---
      match /messages/{messageId} {
        // Use the participants list from the parent chat document.
        allow read: if isAuth() && (get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]) || isAdmin());
        allow create: if isAuth() && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]);
        allow update, delete: if isAdmin();
      }
    }

    // -------------------------------------------------------------------------
    // NOTIFICATIONS COLLECTION
    // -------------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow create: if isAuth();
      allow read, update, delete: if isAuth() && isOwner(resource.data.recipientId);
    }

    // -------------------------------------------------------------------------
    // FRIEND REQUESTS COLLECTION
    // -------------------------------------------------------------------------
    match /friend_requests/{docId} {
      // Users can see requests they sent or received, OR any accepted friendship (for public statistics)
      allow read: if isAuth() && (
        resource.data.from == request.auth.uid || 
        resource.data.to == request.auth.uid ||
        resource.data.status == 'accepted'
      );
      
      // Creating a request: must be from the sender
      allow create: if isAuth() && request.resource.data.from == request.auth.uid;
      
      // Deleting a request: sender can cancel, recipient can decline/accept
      allow delete: if isAuth() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      
      // Updating a request: participants can accept
      allow update: if isAuth() && request.auth.uid in resource.data.participants;
    }
  }
}
