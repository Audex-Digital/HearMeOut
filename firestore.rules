/**
 * firestore.rules
 * 
 * Defines access control for the HearMeOut Firestore database.
 * 
 * Architecture:
 * - Public: Posts (read-only)
 * - Users: Must be authenticated, can only write to their own profile/likes/requests.
 * - Social: Likes and comments use atomic counters on the parent post.
 * - Validation: Ensures users don't modify critical system fields or metadata.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /** Check if the user is authenticated with Firebase Auth. */
    function isAuth() {
      return request.auth != null;
    }

    /** Check if the authenticated user's UID matches the provided UID. */
    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // -------------------------------------------------------------------------
    // POSTS COLLECTION
    // -------------------------------------------------------------------------
    match /posts/{postId} {
      // Allow any visitor to browse the feed.
      allow read: if true;
      
      // Creating a post requires authentication.
      allow create: if isAuth();

      // Update post permission:
      // 1. Owners can update their own post content, but cannot cheat the like count.
      // 2. Any logged-in user can update ONLY the 'likes' or 'commentCount' field (via transactions).
      allow update: if isAuth() && (
        (isOwner(resource.data.authorId) && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes', 'commentCount'])
        )
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentCount']))
      );

      // Only the author can delete their post.
      allow delete: if isAuth() && isOwner(resource.data.authorId);

      // --- Likes Subcollection ---
      // Used for tracking if a specific user has liked a post (idempotency).
      match /likes/{likeId} {
        allow read: if isAuth();
        // Users can only create/delete their own like document.
        allow create: if isAuth() && isOwner(likeId);
        allow delete: if isAuth() && isOwner(likeId);
      }

      // --- Comments Subcollection ---
      // Replies to a specific post.
      match /comments/{commentId} {
        allow read, write: if isAuth();
      }
    }

    // -------------------------------------------------------------------------
    // USERS COLLECTION
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // Users can see other users (required for showing usernames in feed).
      allow read: if isAuth();
      // Users can only modify their own data (profiles, bio, friend lists).
      allow write: if isAuth() && isOwner(userId);
    }

    // -------------------------------------------------------------------------
    // USERNAMES COLLECTION (Uniqueness reservation)
    // -------------------------------------------------------------------------
    match /usernames/{lowercaseUsername} {
      // Required for availability checks
      allow read: if isAuth();
      // Only the owner can create a reservation
      allow create: if isAuth() && isOwner(request.resource.data.uid);
      // Only the owner can delete a reservation
      allow delete: if isAuth() && isOwner(resource.data.uid);
    }

    // -------------------------------------------------------------------------
    // NOTIFICATIONS COLLECTION
    // -------------------------------------------------------------------------
    match /notifications/{notificationId} {
      // Any authenticated user can trigger a notification (e.g., liking a post).
      allow create: if isAuth();
      // Only the recipient can view, mark as read, or dismiss their notifications.
      allow read, update, delete: if isAuth() && isOwner(resource.data.recipientId);
    }

    // -------------------------------------------------------------------------
    // FRIEND REQUESTS COLLECTION (Generic fallback if using dedicated collection)
    // -------------------------------------------------------------------------
    match /friend_requests/{docId} {
      allow read, write: if isAuth();
    }
  }
}
