rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin Helper
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Owner Helper
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Admins can read all users and delete any user
      allow read: if request.auth != null && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
      
      // User creation (signup)
      allow create: if request.auth != null && isOwner(userId) 
        && request.resource.data.role == 'user';

      // Updates
      allow update: if request.auth != null && (
        isOwner(userId) || 
        // Allow other users to ONLY update the friendRequestsReceived array when sending a request
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendRequestsReceived']) &&
          request.resource.data.friendRequestsReceived.hasAll(resource.data.friendRequestsReceived) &&
          request.resource.data.friendRequestsReceived.size() == resource.data.friendRequestsReceived.size() + 1 &&
          request.auth.uid in request.resource.data.friendRequestsReceived
        ) ||
        // Allow other users to ONLY update the friends/requests arrays when removing a friend or cleaning up
        // (This part is complex via rules; usually easier via a separate requests collection, 
        // but this logic covers the 'send' part which is the primary external write)
        (
          isAdmin() ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasAny(['friends', 'friendRequestsSent', 'friendRequestsReceived'])
          )
        )
      );
      
      // Simplified update rule for clarity:
      // 1. Owners can update anything except their role.
      // 2. Admins can update roles.
      // 3. Other users can "nudge" friendRequestsReceived.
      allow update: if request.auth != null && (
        (isOwner(userId) && request.resource.data.role == resource.data.role) ||
        isAdmin() ||
        (
          // External friend request 'nudge'
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendRequestsReceived']) &&
          request.auth.uid in request.resource.data.friendRequestsReceived
        ) ||
         (
          // External friend removal or request cleanup 'nudge'
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['friends', 'friendRequestsSent', 'friendRequestsReceived']) &&
          request.auth.uid in (resource.data.friends.concat(resource.data.friendRequestsSent).concat(resource.data.friendRequestsReceived))
        )
      );
    }

    // Standard collections
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isAdmin());
    }
  }
}
